# Bliss Bakery - Environment Variables
# Copy this to .env and fill in your values

# Database (MySQL)
DATABASE_URL="mysql://root:root@localhost:3306/blissbakery"

# Auth — REQUIRED: Generate with: openssl rand -base64 32
OTP_EXPIRY_MINUTES=5
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# WhatsApp API (Interakt/Wati/Twilio)
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""
WHATSAPP_STAFF_NUMBER=""

# SMS Gateway (fallback)
SMS_API_URL=""
SMS_API_KEY=""

# File Storage
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE=5242880

# App
NEXT_PUBLIC_APP_NAME="Bliss Bakery"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
